
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


// ==========================================
// USER
// ==========================================

model User {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  email String  @unique
  name  String?
  posts Post[]
}


// ==========================================
// POST
// ==========================================

model Post {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  content   String?
  published Boolean @default(false)

  author   User   @relation(fields: [authorId], references: [id])
  authorId String @db.ObjectId
}


// ==========================================
// PATIENT
// ==========================================
model Patient {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId

  name       String
  age        Int?
  gender     String?
  mobile     String?
  email      String   @unique
  bloodGroup String?
  address    String?
  emergency  String?
  condition  String?

  password   String?

  googleId   String?  

  role       String   @default("PATIENT")

  createdAt  DateTime @default(now())

  bookings Booking[]
}

// ==========================================
// BOOKING
// ==========================================
model Booking {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Patient (ab optional — guest/emergency booking allow karne ke liye)
  patientId String?  @db.ObjectId
  patient   Patient? @relation(fields: [patientId], references: [id])

  // Booking details
  pickupLocation String
  destination    String  @default("Nearest Hospital")
  emergencyType  String  @default("General Emergency")
  ambulanceType  String  @default("Basic Life Support")
  mobile         String

  // GPS coordinates — live tracking ke liye zaroori
  latitude  Float?
  longitude Float?

  // Pending / Approved / On the Way /
  // Arrived / Completed / Cancelled
  status String @default("Pending")

  createdAt DateTime @default(now())

  // Assigned ambulance
  ambulanceId String?     @db.ObjectId
  ambulance   Ambulance?  @relation(fields: [ambulanceId], references: [id])
}


// ==========================================
// AMBULANCE
// ==========================================

model Ambulance {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  vehicleNo   String @unique
  driverName  String
  driverMobile String
  type        String

  // Available / Busy / Emergency
  status String @default("Available")

  // Live GPS location
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())

  // Relations
  bookings Booking[]

  driver Driver?
}


// ==========================================
// DRIVER
// ==========================================

model Driver {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name     String
  email    String   @unique
  mobile   String
  password String

  // DRIVER
  role String @default("DRIVER")

  // One driver = one ambulance
  ambulanceId String?     @unique @db.ObjectId
  ambulance   Ambulance?  @relation(fields: [ambulanceId], references: [id])

  createdAt DateTime @default(now())
}


// ==========================================
// HOSPITAL
// ==========================================

model Hospital {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name    String
  address String
  city    String

  // Hospital location
  latitude  Float
  longitude Float

  // Hospital contact
  phone String?

  // Availability
  bedsAvailable Int @default(0)
  icuAvailable  Int @default(0)

  // Emergency facility
  emergencySupport Boolean @default(true)

  // Low / Medium / High
  trafficLevel String @default("Low")

  // Available / Busy / Emergency / Closed
  status String @default("Available")

  createdAt DateTime? @default(now())
}


// ==========================================
// LOGIN HISTORY
// ==========================================

model LoginHistory {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  email  String
  loginAt DateTime @default(now())
}